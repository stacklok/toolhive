# Copy to the repo root as `.env.entra-obo` (gitignored) and fill in from the
# Entra admin center. See README.md in this directory for how to create each
# object. Never commit the filled-in copy.
#
# `task thv-operator-e2e-test-entra` loads the file with Task's dotenv support;
# exported variables in your shell take precedence.

# Directory (tenant) ID. Must be the GUID, not a domain: the suite builds the
# v2.0 issuer from it, and Entra's issuer always carries the GUID.
TOOLHIVE_E2E_ENTRA_TENANT_ID=

# The middle-tier app registration: the confidential client ToolHive uses for
# the OBO exchange, and the audience of the incoming user token.
TOOLHIVE_E2E_ENTRA_PROXY_CLIENT_ID=
TOOLHIVE_E2E_ENTRA_PROXY_CLIENT_SECRET=

# The downstream (backend) API: the scope ToolHive requests in the exchange,
# and the `aud` the exchanged token must carry (the backend app's client ID,
# since it issues v2 tokens).
TOOLHIVE_E2E_ENTRA_BACKEND_SCOPE=api://<backend client ID>/.default
TOOLHIVE_E2E_ENTRA_BACKEND_AUDIENCE=

# Optional. A user access token for the middle-tier app. When unset, the suite
# runs `az account get-access-token --scope <TOOLHIVE_E2E_ENTRA_USER_SCOPE>`
# against your `az login` session.
#TOOLHIVE_E2E_ENTRA_USER_TOKEN=
# Optional. Default: api://<TOOLHIVE_E2E_ENTRA_PROXY_CLIENT_ID>/.default
#TOOLHIVE_E2E_ENTRA_USER_SCOPE=

# Optional negative cases; each is skipped when its variable is unset.
# A scope the middle-tier app has NOT been granted (expects 401).
#TOOLHIVE_E2E_ENTRA_UNCONSENTED_SCOPE=api://<backend client ID>/unconsented.scope
# A scope whose app is targeted by a conditional-access policy the test user
# cannot satisfy without interaction (expects 403 and an audit event).
#TOOLHIVE_E2E_ENTRA_CA_SCOPE=
